{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveKgb",
  "version": "0.6.0",
  "identifier": "fr.potes.livekgb",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "LiveKgb overlay",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "visible": true
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "LiveKgb",
        "width": 460,
        "height": 900,
        "minWidth": 380,
        "minHeight": 400,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; media-src 'self' https: data: blob:; frame-src https: http://localhost:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost ws: wss:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "category": "Entertainment",
    "shortDescription": "Overlay de blagues entre potes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxMTU2NEUzQjk5Qzk1NzAKUldSd2xaeTU0MlFWUWJmZGdwYW1hK2w1L3hKa0RDVUxRRS9rMmtZbkFKbTRyZSs3WTU5ckxHWVIK",
      "endpoints": [
        "https://github.com/aurelinkk/CacaboxV2/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
